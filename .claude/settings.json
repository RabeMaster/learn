{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "if": "Bash(git commit*)",
            "statusMessage": "커밋 메시지 콜라보레이터 검사",
            "command": "sh .claude/hooks/commit-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "if": "Bash(git push*)",
            "statusMessage": "push 정책 검사",
            "command": "sh .claude/hooks/push-guard.sh"
          }
        ]
      }
    ]
  }
}
